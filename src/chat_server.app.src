%% File: src/chat_server.app.src
{application, chat_server,
 [
  {description, "An OTP application"},
  {vsn, "0.1.0"},
  {registered, []},
  {mod, {chat_server_app, []}},
  {applications, [
      kernel,
      stdlib
  ]},

  %% Default is "client mode": start_server = false
  {env, [
      {start_server, false}
  ]},

  %% List all your modules
  {modules, [
      chat_client,
      chat_server,
      chat_server_app,
      chat_server_sup
  ]},

  {licenses, ["Apache 2.0"]},
  {links, []}
 ]}.
