{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "ChatServerInstance": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "InstanceType": "t2.micro",
        "KeyName": "erl_server_ec2",
        "ImageId": "ami-0c02fb55956c7d316",
        "SecurityGroupIds": [
          { "Ref": "ChatServerSecurityGroup" }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": "ChatServer"
          }
        ]
      }
    },
    "ChatServerSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Allow SSH and Chat Server access",
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 22,
            "ToPort": 22,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 8080,
            "ToPort": 8080,
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": "ChatServerSG"
          }
        ]
      }
    }
  },
  "Outputs": {
    "InstanceId": {
      "Description": "ID of the created EC2 instance",
      "Value": { "Ref": "ChatServerInstance" }
    },
    "PublicIP": {
      "Description": "Public IP address of the instance",
      "Value": { "Fn::GetAtt": ["ChatServerInstance", "PublicIp"] }
    },
    "SecurityGroup": {
      "Description": "Name of the security group",
      "Value": { "Ref": "ChatServerSecurityGroup" }
    }
  }
}
